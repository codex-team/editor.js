{
  "name": "@editorjs/editorjs",
  "version": "2.32.0-rc.5",
  "description": "Editor.js — open source block-style WYSIWYG editor with JSON output",
  "main": "dist/editorjs.umd.js",
  "module": "dist/editorjs.mjs",
  "types": "./types/index.d.ts",
